# Dariltweens Nigeria Limited — Payment Voucher Pro v4.4 Client Template
NODE_ENV=production
PORT=3000

# Create a NEW empty PostgreSQL database for every client.
DATABASE_URL="postgresql://DARILTWEENS_DB_USER:CHANGE_ME@localhost:5432/dariltween_payment_voucher"

# Generate a unique long random secret for every client.
JWT_SECRET="REPLACE_WITH_A_UNIQUE_RANDOM_SECRET"

JWT_EXPIRES_IN=8h
REMEMBER_EXPIRES_IN=30d

# Leave workflow email off unless the client buys/enables that option.
EMAIL_NOTIFICATIONS_ENABLED=false

# Email verification remains off unless transactional SMTP is configured.
# REQUIRE_EMAIL_VERIFICATION is configured from Settings after installation.

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Optional: if pg_dump/psql are not in PATH on Windows.
# PG_BIN=C:\Program Files\PostgreSQL\16\bin

# Set this after the client has a real domain.
# APP_URL=https://pv.clientdomain.com
APP_URL=http://localhost:3000
