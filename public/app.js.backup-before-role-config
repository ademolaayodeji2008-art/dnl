async function createItem(){try{const base=$('itBase').value,conversions=[];if(base!=='CARTON'&&Number($('itCarton').value)>0)conversions.push({transactionUnit:'CARTON',converter:Number($('itCarton').value)});if(base!=='BAG'&&Number($('itBag').value)>0)conversions.push({transactionUnit:'BAG',converter:Number($('itBag').value)});if(base!=='KG')conversions.push({transactionUnit:'KG',converter:1});await api('/inventory/items',{method:'POST',body:JSON.stringify({name:$('itName').value,category:$('itCat').value,baseUnit:base,openingStock:$('itOpening').value,costPrice:$('itCost').value,sellingPrice:$('itSell').value,reorderLevel:$('itReorder').value,conversions})});salesOptions=null;toast('Item created.');renderItems()}catch(e){toast(e.message,true)}}

async function renderNewInvoice(){
  document.body.classList.add('invoice-focus');
  setTitle('New Sales Invoice','Professional invoice with split settlement and PDC support');
  const [o,banks]=await Promise.all([getSalesOptions(true),api('/sales/active-banks')]);
