      <td>${esc(v.department)}</td>
      <td>₦${Number(v.totalAmount).toLocaleString()}</td>
      <td><span class="pill">${esc(v.status)}</span></td>
      <td>
        <button class="ghost" onclick="viewVoucher('${v.id}','${mode}')">View Details</button>
        ${mode==='approve'?`<button class="ok" onclick="approve('${v.id}')">Approve</button> <button class="danger" onclick="rejectPv('${v.id}')">Reject</button>`:
          mode==='pay'?`<button class="ok" onclick="payPv('${v.id}')">Mark Paid</button>`:
