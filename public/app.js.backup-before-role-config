async function addLevel(id){
  const name=await uiInput('Level name, e.g. Account Officer / CEO','',{title:'Add Approval Level'});if(!name)return;
  const mode=((await uiInput('Approval rule: ANY or ALL','ANY',{title:'Add Approval Level'}))||'ANY').toUpperCase();
  const levelNo=Number((await uiInput('Level number','1',{title:'Add Approval Level',type:'number'}))||1);
  const minApprovals=Number((await uiInput('Minimum approvals','1',{title:'Add Approval Level',type:'number'}))||1);
  try{
    await api(`/admin/workflows/${id}/levels`,{method:'POST',body:JSON.stringify({name,mode,levelNo,minApprovals})});
    delete state.cache.workflow;toast('Approval level added.');page('workflow',true);
  }catch(e){toast(e.message,true)}
}
async function authorize(levelId){
  try{
    const d=state.cache.workflow||await api('/admin/workflows');
    const wf=d.workflows.find(w=>(w.levels||[]).some(l=>l.id===levelId));
    const level=wf?.levels.find(l=>l.id===levelId);
    const already=new Set((level?.approvers||[]).filter(a=>a.active).map(a=>a.userId));
    const available=d.users.filter(u=>!already.has(u.id));
    if(!available.length){toast('All active users are already authorized on this level.');return}
    const list=available.map((u,i)=>`${i+1}. ${u.firstName} ${u.lastName} — ${(u.roles||[]).join(', ')||'STAFF'} — ${u.email}`).join('\n');
    const n=Number(await uiInput('Choose the user to authorize:\n\n'+list,'1',{title:'Authorize Approver',type:'number'}));
    if(!n||!available[n-1])return;
    await api(`/admin/levels/${levelId}/approvers`,{method:'POST',body:JSON.stringify({userId:available[n-1].id})});
    delete state.cache.workflow;toast(`${available[n-1].firstName} ${available[n-1].lastName} authorized.`);page('workflow',true);
  }catch(e){toast(e.message,true)}
}
async function removeApprover(levelId,userId,name){
  if(!await uiConfirm(`Remove ${name} from this approval level?`,'Remove Approver','warning'))return;
  try{
    await api(`/admin/levels/${levelId}/approvers/${userId}`,{method:'DELETE'});
    delete state.cache.workflow;toast('Approver removed.');page('workflow',true);
  }catch(e){toast(e.message,true)}
}
async function editWorkflow(id){
  const d=state.cache.workflow||await api('/admin/workflows');const w=d.workflows.find(x=>x.id===id);if(!w)return;
  const name=await uiInput('Workflow name',w.name,{title:'Edit Workflow'});if(name===null)return;
  const minAmount=await uiInput('Minimum amount',w.minAmount,{title:'Edit Workflow',type:'number'});if(minAmount===null)return;
  const maxAmount=await uiInput('Maximum amount (leave blank for unlimited)',w.maxAmount??'',{title:'Edit Workflow',type:'number'});if(maxAmount===null)return;
  const department=await uiInput('Department (leave blank for all departments)',w.department??'',{title:'Edit Workflow'});if(department===null)return;
  try{
    await api(`/admin/workflows/${id}`,{method:'PUT',body:JSON.stringify({name,minAmount,maxAmount:maxAmount||null,department:department||null})});
    delete state.cache.workflow;toast('Workflow updated.');page('workflow',true);
  }catch(e){toast(e.message,true)}
}
