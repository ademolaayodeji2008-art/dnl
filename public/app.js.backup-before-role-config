const $=id=>document.getElementById(id);

function isMobileNav(){return window.matchMedia('(max-width:900px)').matches}
function toggleMobileSidebar(){
  if(!isMobileNav())return;
  const open=!$('sidebar').classList.contains('mobile-open');
  $('sidebar').classList.toggle('mobile-open',open);
  $('sidebarOverlay').classList.toggle('show',open);
  $('mobileMenuBtn')?.setAttribute('aria-expanded',String(open));
  document.body.classList.toggle('nav-open',open);
}
function closeMobileSidebar(){
  $('sidebar')?.classList.remove('mobile-open');
  $('sidebarOverlay')?.classList.remove('show');
  $('mobileMenuBtn')?.setAttribute('aria-expanded','false');
  document.body.classList.remove('nav-open');
}
function toggleSidebar(){
  if(isMobileNav())return toggleMobileSidebar();
  const collapsed=!document.body.classList.contains('sidebar-collapsed');
  document.body.classList.toggle('sidebar-collapsed',collapsed);
  localStorage.setItem('dnl_sidebar_collapsed',collapsed?'1':'0');
}
function restoreSidebar(){if(!isMobileNav()&&localStorage.getItem('dnl_sidebar_collapsed')==='1')document.body.classList.add('sidebar-collapsed')}
window.addEventListener('resize',()=>{if(!isMobileNav())closeMobileSidebar()});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeMobileSidebar()});

function passwordPolicyClient(p){
  p=String(p||'');
  return {length:p.length>=10,upper:/[A-Z]/.test(p),lower:/[a-z]/.test(p),number:/[0-9]/.test(p),special:/[^A-Za-z0-9]/.test(p)};
}
function passwordPolicyText(p){const x=passwordPolicyClient(p);return `<div class="password-rules"><span class="${x.length?'ok-rule':''}">10+ characters</span><span class="${x.upper?'ok-rule':''}">Uppercase</span><span class="${x.lower?'ok-rule':''}">Lowercase</span><span class="${x.number?'ok-rule':''}">Number</span><span class="${x.special?'ok-rule':''}">Special symbol</span></div>`}
function renderPasswordRules(inputId,targetId){const t=$(targetId);if(t)t.innerHTML=passwordPolicyText($(inputId)?.value||'');}

const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
function loading(on,title='Loading…',text=''){ $('loader').classList.toggle('hidden',!on);$('loaderTitle').textContent=title;$('loaderText').textContent=text; }
function toast(msg,err=false){const d=document.createElement('div');d.className='toast'+(err?' err':'');d.textContent=msg;$('toast').appendChild(d);setTimeout(()=>d.remove(),3000)}
function uiDialog({title='Dariltweens',message='',value='',type='text',confirmText='Continue',cancelText='Cancel',showInput=false,showCancel=true,tone='info',options=null,multiline=false}={}){
  return new Promise(resolve=>{
    const old=document.getElementById('uiDialogOverlay');if(old)old.remove();
    const overlay=document.createElement('div');overlay.id='uiDialogOverlay';overlay.className='ui-dialog-overlay';
    const icon=tone==='danger'?'!':tone==='success'?'✓':tone==='warning'?'!':'i';
    const optionHtml=Array.isArray(options)?`<select id="uiDialogInput" class="control ui-dialog-input">${options.map(o=>`<option value="${esc(o.value)}" ${String(o.value)===String(value)?'selected':''}>${esc(o.label)}</option>`).join('')}</select>`:(showInput?(multiline?`<textarea id="uiDialogInput" class="control ui-dialog-input" rows="6">${esc(value)}</textarea>`:`<input id="uiDialogInput" class="control ui-dialog-input" type="${esc(type)}" value="${esc(value)}">`):'');
    overlay.innerHTML=`<div class="ui-dialog-card" role="dialog" aria-modal="true"><div class="ui-dialog-head"><div class="ui-dialog-icon ${tone}">${icon}</div><div><h3>${esc(title)}</h3><p>${esc(message).replace(/\n/g,'<br>')}</p></div></div>${optionHtml}<div class="ui-dialog-actions">${showCancel?`<button type="button" class="ghost" id="uiDialogCancel">${esc(cancelText)}</button>`:''}<button type="button" class="primary" id="uiDialogConfirm">${esc(confirmText)}</button></div></div>`;
    document.body.appendChild(overlay);
    const input=overlay.querySelector('#uiDialogInput');if(input){setTimeout(()=>{input.focus();if(input.select)input.select()},20)}
    const finish=v=>{overlay.remove();resolve(v)};
    overlay.querySelector('#uiDialogConfirm').onclick=()=>finish(input?input.value:true);
    overlay.querySelector('#uiDialogCancel')?.addEventListener('click',()=>finish(showInput?null:false));
    overlay.addEventListener('click',e=>{if(e.target===overlay)finish(showInput?null:false)});
    const key=e=>{if(!document.body.contains(overlay)){document.removeEventListener('keydown',key);return}if(e.key==='Escape')finish(showInput?null:false);if(e.key==='Enter'&&showInput&&!multiline)finish(input?.value??'')};document.addEventListener('keydown',key,{once:false});
  });
}
function uiInput(message,value='',opts={}){return uiDialog({title:opts.title||'Enter Details',message,value,type:opts.type||'text',confirmText:opts.confirmText||'Continue',showInput:true,showCancel:true,tone:opts.tone||'info',options:opts.options||null,multiline:!!opts.multiline})}
function uiConfirm(message,title='Please Confirm',tone='warning'){return uiDialog({title,message,confirmText:'Confirm',showCancel:true,tone})}
function uiMessage(message,title='Dariltweens',tone='info'){return uiDialog({title,message,confirmText:'OK',showCancel:false,tone})}
async function api(url,opt={}){
  const headers={'Content-Type':'application/json',...(opt.headers||{})};
  if(state.token) headers.Authorization='Bearer '+state.token;
  const res=await fetch('/api'+url,{...opt,headers});
  if(res.status===401 && state.token){state.token='';localStorage.removeItem('pv_token');showAuth();}
  const type=res.headers.get('content-type')||'';
  const data=type.includes('json')?await res.json():await res.text();
  if(!res.ok) throw new Error(data.message||data||'Request failed.');
  return data;
}
async function apiForm(url,form,opt={}){const headers={...(opt.headers||{})};if(state.token)headers.Authorization='Bearer '+state.token;const res=await fetch('/api'+url,{method:opt.method||'POST',headers,body:form});const type=res.headers.get('content-type')||'';const data=type.includes('json')?await res.json():await res.text();if(!res.ok)throw new Error(data.message||data||'Request failed.');return data}
