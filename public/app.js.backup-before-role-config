function addLineWithData(item,cats){
  const id='l'+Date.now()+Math.random().toString(16).slice(2);
  const d=document.createElement('div');d.className='row';d.id=id;
  d.innerHTML=`<div><label>Expense Category</label><select class="control cat">${cats.map(c=>`<option value="${c.id}" ${c.id===item.categoryId?'selected':''}>${esc(c.name)}</option>`).join('')}</select></div>
  <div style="grid-column:span 2"><label>Description</label><input class="control desc" value="${esc(item.description||'')}"></div>
  <div><label>Amount</label><input class="control amt" type="number" min="0" step="0.01" value="${Number(item.amount||0)}" oninput="calcTotal()"></div>
  <button class="danger" onclick="document.getElementById('${id}').remove();calcTotal()">Remove</button>`;
  $('lines').appendChild(d);
}
async function saveVoucherEdit(id){
  try{
    loading(true,'Saving changes…','Updating voucher and approval revision');
    const items=[...$('lines').children].map(r=>({
      categoryId:r.querySelector('.cat').value,
      description:r.querySelector('.desc').value,
      amount:Number(r.querySelector('.amt').value)
    }));
    const updated=await api(`/vouchers/${id}`,{method:'PUT',body:JSON.stringify({
      payee:$('payee').value,department:$('department').value,paymentType:$('paymentType').value,
      description:$('description').value,dueDate:$('dueDate').value||null,bankDetails:$('bankDetails').value,items
    })});
    toast(updated.status==='PENDING_APPROVAL'?'Voucher updated. Approval restarted on the new revision.':'Voucher updated.');
    state.currentVoucher=null;state.cache={};await viewVoucher(id,'my');
  }catch(e){toast(e.message,true)}finally{loading(false)}
}
async function approve(id){const comments=(await uiInput('Approval comments (optional):','',{title:'Approve Payment Voucher'}))||'';await api(`/vouchers/${id}/approve`,{method:'POST',body:JSON.stringify({comments})});toast('Approved.');page('approvals',true)}
async function rejectPv(id){const reason=await uiInput('Reason for rejection:','',{title:'Reject Payment Voucher',tone:'warning'});if(!reason)return;await api(`/vouchers/${id}/reject`,{method:'POST',body:JSON.stringify({reason})});toast('Rejected.');page('approvals',true)}
async function payPv(id){
  const method=await uiInput('Payment method','Bank Transfer',{title:'Record PV Payment'});if(method===null)return;
  const account=(await uiInput('Payment account / bank (optional)','',{title:'Record PV Payment'}))||'';
  const reference=(await uiInput('Payment reference:','',{title:'Record PV Payment'}))||'';
  loading(true,'Recording payment…','Posting expenses automatically');
  try{
    await api(`/vouchers/${id}/pay`,{method:'POST',body:JSON.stringify({
      paymentDate:new Date().toISOString(),paymentMethod:method,paymentAccount:account,reference
    })});
    toast('Payment recorded and expense posted.');
    state.currentVoucher=null;page('payments',true);
  }catch(e){toast(e.message,true)}finally{loading(false)}
}
