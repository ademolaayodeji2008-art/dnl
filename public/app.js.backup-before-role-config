    </tr>`).join('')||'<tr><td colspan="6">No records.</td></tr>'
  }</tbody></table></div>`;
}

function voucherStatusTitle(status){
  const map={
    DRAFT:'Draft',PENDING_APPROVAL:'Pending Approval',REJECTED:'Rejected',
    APPROVED_PENDING_PAYMENT:'Approved · Pending Payment',
    PAID_AWAITING_CONFIRMATION:'Paid · Awaiting Receipt Confirmation',
    COMPLETED:'Completed',TERMINATED:'Terminated'
  };
  return map[status]||status;
}
function fmtDate(v){if(!v)return '—';const d=new Date(v);return Number.isNaN(d.getTime())?esc(v):d.toLocaleString()}
