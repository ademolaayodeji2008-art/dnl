async function renderSequences(){setTitle('Document Numbering','Control prefixes and number lengths for system-generated documents');const rows=await api('/accounting/sequences');$('content').innerHTML=`<div class="card safe-card"><p class="muted">Changing a prefix affects future documents only. Existing document numbers are not changed.</p><div class="tablewrap"><table><thead><tr><th>Code</th><th>Prefix</th><th>Last No.</th><th>Padding</th><th>Year</th><th>Action</th></tr></thead><tbody>${rows.map(x=>`<tr><td><b>${esc(x.code)}</b></td><td>${esc(x.prefix)}</td><td>${x.lastNo}</td><td>${x.padLength}</td><td>${x.year||''}</td><td><button class="ghost" onclick="editSequence('${x.code}','${esc(x.prefix)}',${x.padLength})">Edit</button></td></tr>`).join('')}</tbody></table></div></div>`}
