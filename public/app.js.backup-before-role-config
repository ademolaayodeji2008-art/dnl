async function editLevel(id){
  const d=state.cache.workflow||await api('/admin/workflows');let l=null;
  for(const w of d.workflows){l=(w.levels||[]).find(x=>x.id===id);if(l)break} if(!l)return;
  const name=await uiInput('Level name',l.name,{title:'Edit Approval Level'});if(name===null)return;
  const mode=((await uiInput('Approval rule: ANY or ALL',l.mode,{title:'Edit Approval Level'}))||l.mode).toUpperCase();
  const levelNo=Number((await uiInput('Level number',l.levelNo,{title:'Edit Approval Level',type:'number'}))||l.levelNo);
  const minApprovals=Number((await uiInput('Minimum approvals',l.minApprovals,{title:'Edit Approval Level',type:'number'}))||l.minApprovals);
  try{
    await api(`/admin/levels/${id}`,{method:'PUT',body:JSON.stringify({name,mode,levelNo,minApprovals})});
    delete state.cache.workflow;toast('Approval level updated.');page('workflow',true);
  }catch(e){toast(e.message,true)}
}
