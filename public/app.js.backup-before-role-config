function manageUserRoles(userId){
  const d=state.userAdminData||{},u=(d.users||[]).find(x=>x.id===userId);
  if(!u)return toast('User record not found.',true);
  const overlay=document.createElement('div');overlay.className='role-overlay';
  const current=new Set(u.roles||[]);
  overlay.onclick=e=>{if(e.target===overlay)overlay.remove()};
  overlay.innerHTML=`<div class="role-panel"><div class="toolbar"><div><h3 style="margin:0">Manage Roles</h3><div class="muted">${esc(u.firstName)} ${esc(u.lastName)} · ${esc(u.email)}</div></div><button class="ghost" onclick="this.closest('.role-overlay').remove()">Close</button></div>
    <p class="muted">A user can have multiple roles. STAFF is retained automatically as the base role.</p>
    <div class="role-grid">${(d.roles||[]).map(r=>`<label class="role-choice ${r.code==='STAFF'?'base-role':''}"><input type="checkbox" name="managedRole" value="${esc(r.code)}" ${current.has(r.code)?'checked':''} ${r.code==='STAFF'?'checked disabled':''}><span><b>${esc(r.name)}</b><small>${esc(r.code.replaceAll('_',' '))}</small></span></label>`).join('')}</div>
    <div class="toolbar" style="margin-top:18px"><span class="muted">Changes are recorded in Audit Trail.</span><button class="primary" onclick="saveManagedRoles('${u.id}')">Save Roles</button></div>
  </div>`;
  document.body.appendChild(overlay);
}
async function saveManagedRoles(userId){
  try{
    const roles=[...document.querySelectorAll('input[name="managedRole"]:checked')].map(x=>x.value);
    loading(true,'Updating roles…','Applying new permissions');
    const r=await api(`/admin/users/${userId}/roles`,{method:'PUT',body:JSON.stringify({roles})});
    document.querySelector('.role-overlay')?.remove();
    delete state.cache.users;toast(r.message||'Roles updated.');
    await page('users',true);
  }catch(e){toast(e.message,true)}finally{loading(false)}
}
