    setTitle(`Edit ${v.pvNo}`,'Changes to a submitted PV restart approval automatically');
    $('content').innerHTML=`<div class="card">
      <div class="notice edit-notice"><b>Edit control:</b> You may edit this voucher only before final approval. If it is already pending approval, saving changes creates a new revision and restarts approval from Level 1.</div>
      <div class="row">
        <div><label>Payee</label><input id="payee" class="control" value="${esc(v.payee||'')}"></div>
        <div><label>Department</label><input id="department" class="control" value="${esc(v.department||'')}"></div>
        <div><label>Payment Type</label><input id="paymentType" class="control" value="${esc(v.paymentType||'')}"></div>
        <div><label>Due Date</label><input id="dueDate" type="date" class="control" value="${v.dueDate?new Date(v.dueDate).toISOString().slice(0,10):''}"></div>
      </div>
      <label>Description</label><textarea id="description" class="control">${esc(v.description||'')}</textarea>
      <label>Bank Details</label><textarea id="bankDetails" class="control">${esc(v.bankDetails||'')}</textarea>
      <div class="toolbar"><h3>Expense Lines</h3><button class="ghost" onclick="addLine()">+ Add line</button></div>
      <div id="lines"></div>
      <div class="toolbar"><b>Total: ₦<span id="pvTotal">0</span></b><div><button class="ghost" onclick="renderVoucherDetails(state.currentVoucher,state.currentVoucher.from||'my')">Cancel</button> <button class="primary" onclick="saveVoucherEdit('${v.id}')">Save Changes</button></div></div>
