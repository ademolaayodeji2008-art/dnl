function addJournalLine(){const box=$('journalLines');if(!box)return;const opts=(window.glAccounts||[]).filter(x=>x.active&&x.allowPosting).map(x=>`<option value="${x.id}">${esc(x.accountCode)} — ${esc(x.name)}</option>`).join('');box.insertAdjacentHTML('beforeend',`<div class="journal-line"><select class="control jlAccount"><option value="">Account</option>${opts}</select><input class="control jlDebit" type="number" step="0.01" placeholder="Debit"><input class="control jlCredit" type="number" step="0.01" placeholder="Credit"><input class="control jlNarr" placeholder="Narration"><button class="danger" onclick="this.parentElement.remove()">×</button></div>`)}
