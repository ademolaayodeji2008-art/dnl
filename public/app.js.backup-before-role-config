const acctMoney=v=>{const x=Number(v||0);return x<0?`(₦${Math.abs(x).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})})`:`₦${x.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}`};
const acctQS=(obj={})=>Object.entries(obj).filter(([,v])=>v!==''&&v!==null&&v!==undefined).map(([k,v])=>`${encodeURIComponent(k)}=${encodeURIComponent(v)}`).join('&');
function acctDates(prefix='acct'){return {from:$(`${prefix}From`)?.value||'',to:$(`${prefix}To`)?.value||''}}
function acctExportButtons(base,params,name){const q=acctQS(params);return `<button class="ghost" onclick="downloadApiFile('${base}.xlsx${q?'?'+q:''}','${name}.xlsx')">Excel</button> <button class="ghost" onclick="downloadApiFile('${base}.pdf${q?'?'+q:''}','${name}.pdf')">PDF</button>`}

