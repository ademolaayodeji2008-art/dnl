async function excludeReconLine(id,entryId){const note=await uiInput('Reason for excluding this statement line','Bank-only / non-book reconciling item',{title:'Exclude Statement Line'});if(!note)return;try{await api(`/bank-reconciliation/${id}/entries/${entryId}/exclude`,{method:'POST',body:JSON.stringify({note})});toast('Statement line excluded.');openBankReconciliation(id)}catch(e){toast(e.message,true)}}
