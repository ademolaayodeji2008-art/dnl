async function login(){try{
  loading(true,'Signing you in…','Loading your workspace');
  const email=$('loginEmail').value.trim(),remember=$('rememberMe').checked;
  const r=await api('/auth/login',{method:'POST',body:JSON.stringify({email,password:$('loginPassword').value,rememberMe:remember})});
  state.token=r.token;localStorage.setItem('pv_token',r.token);
  if(remember)localStorage.setItem('pv_email',email);else localStorage.removeItem('pv_email');
  state.user=await api('/auth/me');
  if(state.user.mustChangePassword){showForcedPasswordChange();return}
  await startApp();
}catch(e){toast(e.message,true)}finally{loading(false)}}
function showForcedPasswordChange(){
  $('authView').classList.add('hidden');$('appView').classList.remove('hidden');
  $('nav').innerHTML='';$('userName').textContent=state.user.firstName+' '+state.user.lastName;
  setTitle('Change Temporary Password','You must change your temporary password before continuing');
  $('content').innerHTML=`<div class="card" style="max-width:620px;margin:auto"><h3>Set a New Password</h3><p class="muted">Your temporary password cannot be used to continue.</p><label>Current / Temporary Password</label><input id="forceCurrentPassword" type="password" class="control"><label>New Password</label><input id="forceNewPassword" type="password" class="control" oninput="renderPasswordRules('forceNewPassword','forceRules')"><div id="forceRules"></div><label>Confirm New Password</label><input id="forceConfirmPassword" type="password" class="control"><button class="primary wide" onclick="completeForcedPasswordChange()">Change Password</button><button class="link" onclick="logout()">Sign out</button></div>`;
}
async function completeForcedPasswordChange(){
  const a=$('forceNewPassword').value,b=$('forceConfirmPassword').value;
  if(a!==b)return toast('New passwords do not match.',true);
  try{
    loading(true,'Changing password…','Securing your account');
    const r=await api('/auth/change-password',{method:'POST',body:JSON.stringify({currentPassword:$('forceCurrentPassword').value,newPassword:a})});
    toast(r.message||'Password changed. Please sign in again.');
    state.token='';state.user=null;localStorage.removeItem('pv_token');showAuth();
  }catch(e){toast(e.message,true)}finally{loading(false)}
}
async function forgotPassword(){
  const email=$('loginEmail').value.trim()||await uiInput('Enter your registered email address:','',{title:'Forgot Password',type:'email'});
  if(!email)return;
  try{const r=await api('/auth/forgot-password',{method:'POST',body:JSON.stringify({email})});toast(r.message)}catch(e){toast(e.message,true)}
}
async function logout(){loading(true,'Signing you out…','Closing your secure session');try{if(state.token)await api('/auth/logout',{method:'POST'});}catch{}state.token='';state.user=null;state.cache={};localStorage.removeItem('pv_token');$('loginPassword').value='';showAuth();loading(false);toast('Signed out successfully.')}
