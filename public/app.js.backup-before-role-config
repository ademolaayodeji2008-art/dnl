async function refreshReportPreview(){await loadReportDashboard();await previewReport();toast('Report preview refreshed.')}
async function previewReport(){
  await loadReportDashboard();
  const type=$('rType').value;
  loading(true,'Preparing report preview…','Reading the latest records');
  try{
    const summary=await api('/reports/summary?'+reportQs(type==='EXPENSES'));
    renderReportSummary(summary,type);

    if(type==='EXPENSES'){
      const rows=await api('/reports/expenses?'+reportQs(true));
      renderExpensePreview(rows);
      $('reportExportActions').innerHTML=`
        <button class="ghost" onclick="printReport()">Print Preview</button>
        <button class="ghost" onclick="downloadExpenses()">Export Excel</button>`;
    }else{
      const q=reportQs(false); if(type!=='ALL')q.set('status',type);
      const rows=await api('/reports/vouchers?'+q);
      renderVoucherReportPreview(rows,type);
      $('reportExportActions').innerHTML=`
        <button class="ghost" onclick="printReport()">Print Preview</button>
        <button class="ghost" onclick="downloadVoucherReport()">Export Excel</button>`;
    }
  }catch(e){toast(e.message,true)}
  finally{loading(false)}
}
