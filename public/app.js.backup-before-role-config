function parseStatementText(text){return String(text||'').split(/\r?\n/).map(x=>x.trim()).filter(Boolean).map(line=>{const a=line.split(/\t|,/);return {transactionDate:(a[0]||'').trim(),description:(a[1]||'').trim(),reference:(a[2]||'').trim(),debit:Number((a[3]||0).toString().replace(/[^0-9.-]/g,''))||0,credit:Number((a[4]||0).toString().replace(/[^0-9.-]/g,''))||0,balance:a[5]===undefined?'':Number((a[5]||0).toString().replace(/[^0-9.-]/g,''))||0}})}
async function renderBankReconciliation(){setTitle('Bank Reconciliation','Match bank statements to system bank transactions');const [rows,banks]=await Promise.all([api('/bank-reconciliation'),api('/banking/accounts')]);window.bankRecs=rows;window.reconBanks=banks;$('content').innerHTML=`${can('BANK_RECON_CREATE')?`<div class="card safe-card"><h3>Start Bank Reconciliation</h3><div class="safe-form-grid"><select id="brBank" class="control"><option value="">Bank account</option>${banks.filter(x=>x.active).map(x=>`<option value="${x.id}">${esc(x.bankName)} — ${esc(x.accountNumber)}</option>`).join('')}</select><input id="brStart" type="date" class="control"><input id="brEnd" type="date" class="control"><input id="brOpen" type="number" step="0.01" class="control" placeholder="Statement opening balance"><input id="brClose" type="number" step="0.01" class="control" placeholder="Statement closing balance"></div><textarea id="brEntries" class="control recon-paste" placeholder="Optional: paste statement lines as Date, Description, Reference, Debit, Credit, Balance — one line per transaction"></textarea><button class="primary" onclick="createBankReconciliation()">Create Reconciliation</button></div>`:''}<div class="tablewrap"><table><thead><tr><th>Period</th><th>Reconciliation</th><th>Bank</th><th>Statement Closing</th><th>Matched</th><th>Unmatched</th><th>Status</th><th>Action</th></tr></thead><tbody>${rows.map(x=>`<tr><td>${dateOnly(x.statementStartDate)} – ${dateOnly(x.statementEndDate)}</td><td><b>${esc(x.reconciliationNo)}</b></td><td>${esc(x.bank.bankName)} ${esc(x.bank.accountNumber)}</td><td>${money(x.statementClosingBalance)}</td><td>${x.matched}</td><td>${x.unmatched}</td><td>${esc(x.status)}</td><td><button class="ghost" onclick="openBankReconciliation('${x.id}')">Open</button></td></tr>`).join('')||'<tr><td colspan="8">No bank reconciliations.</td></tr>'}</tbody></table></div>`}
async function createBankReconciliation(){try{const entries=parseStatementText($('brEntries').value);const r=await api('/bank-reconciliation',{method:'POST',body:JSON.stringify({bankId:$('brBank').value,statementStartDate:$('brStart').value,statementEndDate:$('brEnd').value,statementOpeningBalance:$('brOpen').value,statementClosingBalance:$('brClose').value,entries})});toast('Bank reconciliation created.');openBankReconciliation(r.id)}catch(e){toast(e.message,true)}}
async function openBankReconciliation(id){try{const d=await api(`/bank-reconciliation/${id}`);window.currentBankRecon=d;setTitle(`Bank Reconciliation — ${d.reconciliationNo}`,`${d.bank.bankName} ${d.bank.accountNumber}`);$('content').innerHTML=`<div class="grid"><div class="card metric"><span>Statement Closing</span><b>${money(d.statementClosingBalance)}</b></div><div class="card metric"><span>Book Closing</span><b>${money(d.bookClosing)}</b></div><div class="card metric"><span>Difference</span><b>${money(d.difference)}</b></div><div class="card metric"><span>Unmatched Statement</span><b>${d.unmatchedStatement.length}</b></div><div class="card metric"><span>Unmatched Book</span><b>${d.unmatchedBook.length}</b></div></div><div class="toolbar"><button class="ghost" onclick="renderBankReconciliation()">← Register</button>${d.status==='DRAFT'&&can('BANK_RECON_MANAGE')?`<button class="ghost" onclick="addBankStatementEntries('${id}')">+ Statement Lines</button><button class="primary" onclick="autoMatchBankRecon('${id}')">Auto Match</button>`:''}${d.status==='DRAFT'&&can('BANK_RECON_COMPLETE')?`<button class="primary" onclick="completeBankRecon('${id}')">Complete</button>`:''}</div><div class="control-two-col"><div class="card safe-card"><h3>Unmatched Statement Lines</h3><div class="tablewrap"><table><thead><tr><th>Date</th><th>Description</th><th>Ref</th><th>Debit</th><th>Credit</th><th>Action</th></tr></thead><tbody>${d.unmatchedStatement.map(x=>`<tr><td>${dateOnly(x.transactionDate)}</td><td>${esc(x.description)}</td><td>${esc(x.reference||'')}</td><td>${money(x.debit)}</td><td>${money(x.credit)}</td><td>${can('BANK_RECON_MANAGE')?`<button class="ghost" onclick="manualMatchRecon('${id}','${x.id}')">Match</button><button class="danger" onclick="excludeReconLine('${id}','${x.id}')">Exclude</button>`:''}</td></tr>`).join('')||'<tr><td colspan="6">None.</td></tr>'}</tbody></table></div></div><div class="card safe-card"><h3>Unmatched System Transactions</h3><div class="tablewrap"><table><thead><tr><th>Date</th><th>No.</th><th>Narration</th><th>Type</th><th>Amount</th></tr></thead><tbody>${d.unmatchedBook.map(x=>`<tr><td>${dateOnly(x.transactionDate)}</td><td>${esc(x.transactionNo)}</td><td>${esc(x.narration)}</td><td>${esc(x.type)}</td><td>${money(x.amount)}</td></tr>`).join('')||'<tr><td colspan="5">None.</td></tr>'}</tbody></table></div></div></div>`}catch(e){toast(e.message,true)}}
