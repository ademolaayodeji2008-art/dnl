async function renderControlSettings(){setTitle('Control Settings','Security, approval and audit thresholds');const d=await api('/controls/settings');const labels={PASSWORD_EXPIRY_DAYS:'Password expiry (days)',LOGIN_MAX_ATTEMPTS:'Failed login attempts before lock',LOCKOUT_MINUTES:'Lockout duration (minutes)',BACKDATE_EXCEPTION_DAYS:'Backdated exception threshold (days)',DISCOUNT_EXCEPTION_PERCENT:'High discount threshold (%)',HIGH_VALUE_EXCEPTION_AMOUNT:'High-value transaction threshold (₦)',PURCHASE_APPROVAL_THRESHOLD:'Purchase approval threshold (₦)',PAYMENT_APPROVAL_THRESHOLD:'Payment approval threshold (₦)',EXPIRY_ALERT_DAYS:'Batch expiry alert horizon (days)'};$('content').innerHTML=`<div class="card safe-card"><h3>System Control Thresholds</h3><p class="muted">These values affect security lockouts, audit flags and high-value transaction controls.</p><div class="settings-grid">${Object.entries(labels).map(([k,l])=>`<label><span>${esc(l)}</span><input id="ctl_${k}" type="number" class="control" value="${esc(d[k]||'')}"></label>`).join('')}</div><button class="primary" onclick="saveControlSettings()">Save Control Settings</button></div>`}
