-dated cheque received. PDCs cover the balance but do not count as payment until cleared.</p><div id="settlementRows"></div><div class="toolbar"><button class="ghost" onclick="addSettlementPayment()">+ Payment</button><button class="ghost" onclick="addSettlementCheque()">+ PDC</button></div><div class="settlement-summary"><div><span>Invoice Total</span><b id="salesTotal">₦0.00</b></div><div><span>Paid Now</span><b id="settlePaid">₦0.00</b></div><div><span>PDC Cover</span><b id="settlePdc">₦0.00</b></div><div><span>Uncovered Balance</span><b id="settleUncovered">₦0.00</b></div></div><button class="primary wide" onclick="saveSalesInvoiceWithSettlement()">Save Invoice & Settlement</button><button class="ghost wide" onclick="saveSalesInvoice(false)">Save Invoice Only</button></div></div></div>`;
  addSalesLine();
}
function addSalesLine(){const o=salesOptions||{items:[]},id='sl'+Date.now()+Math.random().toString(16).slice(2),d=document.createElement('div');d.className='row sales-line';d.id=id;d.innerHTML=`<div><label>Item</label><select class="control slItem" onchange="salesLineItemChanged('${id}')"><option value="">Select item</option>${o.items.map(i=>`<option value="${i.id}">${esc(i.name)} — Stock ${i.currentStock} ${esc(i.baseUnit)}</option>`).join('')}</select></div><div><label>Pickup / Stock Location</label><select class="control slLocation" onchange="calcSalesInvoice()"><option value="">Select item first</option></select><small class="muted slAvail"></small></div><div><label>Sale Unit</label><select class="control slUnit" onchange="salesLineUnitChanged('${id}')"></select></div><div><label>Qty</label><input type="number" class="control slQty" min="0" step="0.01" oninput="calcSalesInvoice()"></div><div><label>Converter</label><input class="control slConv" readonly></div><div><label>Stock Qty</label><input class="control slStock" readonly></div><div><label>Unit Price</label><input type="number" class="control slPrice" min="0" step="0.01" oninput="calcSalesInvoice()"></div><div><label>VAT</label><input type="number" class="control slVat" value="0" min="0" step="0.01" oninput="calcSalesInvoice()"></div><div><label>Line Amount</label><input class="control slAmount" readonly></div><button class="danger" onclick="document.getElementById('${id}').remove();calcSalesInvoice()">×</button>`;$('salesLines').appendChild(d)}
function salesLineItemChanged(id){const row=$(id),item=salesOptions.items.find(i=>i.id===row.querySelector('.slItem').value);if(!item)return;const units=[{transactionUnit:item.baseUnit,converter:1},...item.conversions.filter(c=>c.transactionUnit!==item.baseUnit)];row.querySelector('.slUnit').innerHTML=units.map(u=>`<option value="${esc(u.transactionUnit)}" data-conv="${u.converter}">${esc(u.transactionUnit)}</option>`).join('');row.querySelector('.slPrice').value=item.sellingPrice;row.querySelector('.slLocation').innerHTML='<option value="">Select pickup location</option>'+item.locations.filter(x=>Number(x.quantity)>0).map(x=>`<option value="${x.locationId}">${esc(x.name)} — ${Number(x.quantity).toLocaleString()} ${esc(item.baseUnit)}${x.address?' · '+esc(x.address):''}</option>`).join('');row.querySelector('.slAvail').textContent=item.locations.length?`Available at ${item.locations.filter(x=>Number(x.quantity)>0).length} location(s)`:'No location stock available';salesLineUnitChanged(id)}
function salesLineUnitChanged(id){const row=$(id),sel=row.querySelector('.slUnit'),opt=sel.options[sel.selectedIndex];row.querySelector('.slConv').value=opt?.dataset.conv||1;calcSalesInvoice()}
function calcSalesInvoice(){let total=0;document.querySelectorAll('.sales-line').forEach(row=>{const q=Number(row.querySelector('.slQty').value||0),c=Number(row.querySelector('.slConv').value||1),p=Number(row.querySelector('.slPrice').value||0),v=Number(row.querySelector('.slVat').value||0),a=q*p;row.querySelector('.slStock').value=(q*c).toFixed(4);row.querySelector('.slAmount').value=a.toFixed(2);total+=a+v});total=Math.max(0,total-Number($('siDiscount')?.value||0));if($('salesTotal'))$('salesTotal').textContent=money(total);calcSettlementSummary()}
function collectSalesInvoice(){return {customerId:$('siCustomer').value,invoiceDate:$('siDate').value,dueDate:$('siDue').value||null,discountAmount:Number($('siDiscount').value||0),notes:$('siNotes').value,lines:[...document.querySelectorAll('.sales-line')].map(row=>({itemId:row.querySelector('.slItem').value,locationId:row.querySelector('.slLocation').value,saleUnit:row.querySelector('.slUnit').value,quantity:Number(row.querySelector('.slQty').value||0),unitPrice:Number(row.querySelector('.slPrice').value||0),vatAmount:Number(row.querySelector('.slVat').value||0)}))}}
function bankOptions(){return `<option value="">Select company bank</option>${(window.dnBanks||[]).map(b=>`<option value="${b.id}">${esc(b.bankName)} — ${esc(b.accountNumber)}${b.accountName?' - '+b.accountName:''}</option>`).join('')}`}
function addSettlementPayment(){const id='sp'+Date.now()+Math.random().toString(16).slice(2),d=document.createElement('div');d.className='settlement-row settle-payment';d.id=id;d.innerHTML=`<div class="toolbar"><b>Immediate Payment</b><button class="danger" onclick="$('${id}').remove();calcSettlementSummary()">Remove</button></div><div class="row"><div><label>Method</label><select class="control payMethod" onchange="settlementMethodChanged('${id}')"><option>CASH</option><option selected>TRANSFER</option><option>POS</option><option>OTHER</option></select></div><div><label>Amount</label><input type="number" class="control payAmount" min="0" step="0.01" oninput="calcSettlementSummary()"></div><div class="payBankWrap"><label>Dariltweens Bank</label><select class="control payBank">${bankOptions()}</select></div><div><label>Reference</label><input class="control payRef" placeholder="Transfer/POS reference"></div></div>`;$('settlementRows').appendChild(d);settlementMethodChanged(id)}
function settlementMethodChanged(id){const row=$(id),m=row.querySelector('.payMethod').value;row.querySelector('.payBankWrap').style.display=['TRANSFER','POS'].includes(m)?'block':'none'}
function addSettlementCheque(){const id='sc'+Date.now()+Math.random().toString(16).slice(2),d=document.createElement('div');d.className='settlement-row settle-cheque';d.id=id;const today=new Date().toISOString().slice(0,10);d.innerHTML=`<div class="toolbar"><b>Post-Dated Cheque</b><button class="danger" onclick="$('${id}').remove();calcSettlementSummary()">Remove</button></div><div class="row"><div><label>Cheque No</label><input class="control chqNo"></div><div><label>Drawer Bank</label><input class="control chqBank"></div><div><label>Amount</label><input type="number" class="control chqAmount" min="0" step="0.01" oninput="calcSettlementSummary()"></div><div><label>Cheque Date</label><input type="date" class="control chqDate" value="${today}"></div><div><label>Expected Presentation</label><input type="date" class="control chqExpected" value="${today}"></div></div>`;$('settlementRows').appendChild(d);calcSettlementSummary()}
function invoiceFormTotal(){let total=0;document.querySelectorAll('.sales-line').forEach(r=>total+=Number(r.querySelector('.slAmount').value||0)+Number(r.querySelector('.slVat').value||0));return Math.max(0,total-Number($('siDiscount')?.value||0))}
function calcSettlementSummary(){const total=invoiceFormTotal(),paid=[...document.querySelectorAll('.settle-payment .payAmount')].reduce((s,x)=>s+Number(x.value||0),0),pdc=[...document.querySelectorAll('.settle-cheque .chqAmount')].reduce((s,x)=>s+Number(x.value||0),0);if($('settlePaid'))$('settlePaid').textContent=money(paid);if($('settlePdc'))$('settlePdc').textContent=money(pdc);if($('settleUncovered'))$('settleUncovered').textContent=money(Math.max(0,total-paid-pdc))}
async function saveSalesInvoice(cash=false){try{const data=collectSalesInvoice();if(cash){toast('Use the Settlement Plan to record full or split settlement.',true);return}const r=await api('/sales/invoices',{method:'POST',body:JSON.stringify(data)});toast(`Invoice ${r.invoiceNo} created.`);salesOptions=null;renderSalesInvoices()}catch(e){toast(e.message,true)}}
async function saveSalesInvoiceWithSettlement(){
  try{
    const total=invoiceFormTotal(),payments=[...document.querySelectorAll('.settle-payment')].map(r=>({method:r.querySelector('.payMethod').value,amount:Number(r.querySelector('.payAmount').value||0),bankId:r.querySelector('.payBank')?.value||null,reference:r.querySelector('.payRef').value})).filter(x=>x.amount>0),cheques=[...document.querySelectorAll('.settle-cheque')].map(r=>({chequeNo:r.querySelector('.chqNo').value,drawerBank:r.querySelector('.chqBank').value,amount:Number(r.querySelector('.chqAmount').value||0),chequeDate:r.querySelector('.chqDate').value,expectedPresentationDate:r.querySelector('.chqExpected').value})).filter(x=>x.amount>0);
    const allocated=payments.reduce((s,x)=>s+x.amount,0)+cheques.reduce((s,x)=>s+x.amount,0);if(allocated>total+0.01)return toast('Settlement exceeds the invoice total.',true);
    loading(true,'Saving invoice…','Posting stock, receipts, bank deposits and PDC records');
    const payload={...collectSalesInvoice(),payments,cheques};
    const result=await api('/sales/invoices-with-settlement',{method:'POST',body:JSON.stringify(payload)});
    salesOptions=null;toast(`Invoice ${result.invoice.invoiceNo} and settlement recorded.`);renderSalesInvoices();
  }catch(e){toast(e.message,true)}finally{loading(false)}
}

