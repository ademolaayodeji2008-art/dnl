async function loadTrialBalance(){const p={from:$('tbFrom')?.value||'',to:$('tbTo')?.value||''},d=await api(`/accounting-reports/trial-balance?${acctQS(p)}`);$('tbReportOut').innerHTML=`<div class="card safe-card"><div class="toolbar"><h3>Trial Balance</h3><div>${acctExportButtons('/accounting-reports/trial-balance',p,'DNL_Trial_Balance')}</div></div><div class="tablewrap"><table><thead><tr><th>Code</th><th>Account</th><th>Type</th><th>Opening</th><th>Debit</th><th>Credit</th><th>Closing</th></tr></thead><tbody>${d.rows.map(x=>`<tr><td>${esc(x.code)}</td><td>${esc(x.account)}</td><td>${esc(x.type)}</td><td>${acctMoney(x.opening)}</td><td>${x.debit?acctMoney(x.debit):''}</td><td>${x.credit?acctMoney(x.credit):''}</td><td>${acctMoney(x.closing)}</td></tr>`).join('')}<tr class="report-total"><td colspan="4"><b>Movement Totals</b></td><td><b>${acctMoney(d.totalDebit)}</b></td><td><b>${acctMoney(d.totalCredit)}</b></td><td></td></tr><tr class="report-total"><td colspan="4"><b>Closing Trial Balance</b></td><td><b>${acctMoney(d.closingDebit)}</b></td><td><b>${acctMoney(d.closingCredit)}</b></td><td></td></tr></tbody></table></div></div>`}

async function renderFinancialStatementsPage(){setTitle('Financial Statements','Generate Profit & Loss, Statement of Financial Position and Cash Flow');$('content').innerHTML=`<div class="card safe-card"><div class="accounting-filter-grid"><input id="fsFrom" type="date" class="control"><input id="fsTo" type="date" class="control"><select id="fsType" class="control"><option value="profit-loss">Profit & Loss Statement</option><option value="balance-sheet">Statement of Financial Position</option><option value="cash-flow">Cash Flow Statement</option></select><button class="primary" onclick="loadFinancialStatement()">Generate Statement</button></div></div><div id="fsReportOut"></div>`;await loadFinancialStatement()}
function statementRows(groups){return Object.entries(groups).map(([g,rows])=>`<tr class="statement-section"><td colspan="3"><b>${esc(g)}</b></td></tr>${rows.map(x=>`<tr><td>${esc(x.code||'')}</td><td>${esc(x.account)}</td><td class="num">${acctMoney(x.amount)}</td></tr>`).join('')}`).join('')}
async function loadFinancialStatement(){const type=$('fsType').value,from=$('fsFrom').value,to=$('fsTo').value,p=type==='balance-sheet'?{asOf:to}:{from,to},d=await api(`/accounting-reports/${type}?${acctQS(p)}`);let body='';if(type==='profit-loss'){const t=d.totals;body=`${statementRows(d.groups)}<tr class="report-total"><td></td><td>Gross Profit</td><td>${acctMoney(t.grossProfit)}</td></tr><tr class="report-total"><td></td><td>Profit Before Tax</td><td>${acctMoney(t.profitBeforeTax)}</td></tr><tr class="report-total"><td></td><td>Net Profit / (Loss)</td><td>${acctMoney(t.netProfit)}</td></tr>`}else if(type==='balance-sheet'){const t=d.totals;body=`${statementRows(d.groups)}<tr class="report-total"><td></td><td>Total Assets</td><td>${acctMoney(t.totalAssets)}</td></tr><tr class="report-total"><td></td><td>Total Liabilities</td><td>${acctMoney(t.totalLiabilities)}</td></tr><tr class="report-total"><td></td><td>Total Equity</td><td>${acctMoney(t.totalEquity)}</td></tr><tr class="report-total"><td></td><td>Liabilities + Equity</td><td>${acctMoney(t.liabilitiesEquity)}</td></tr><tr><td></td><td>Balance Check Difference</td><td>${acctMoney(t.difference)}</td></tr>`}else{const t=d.totals;body=`${Object.entries(d.groups).map(([g,rows])=>`<tr class="statement-section"><td colspan="3"><b>${esc(g)} ACTIVITIES</b></td></tr>${rows.map(x=>`<tr><td>${dateOnly(x.date)}</td><td>${esc(x.description)}</td><td>${acctMoney(x.amount)}</td></tr>`).join('')}`).join('')}<tr class="report-total"><td></td><td>Net Cash from Operating Activities</td><td>${acctMoney(t.operating)}</td></tr><tr class="report-total"><td></td><td>Net Cash from Investing Activities</td><td>${acctMoney(t.investing)}</td></tr><tr class="report-total"><td></td><td>Net Cash from Financing Activities</td><td>${acctMoney(t.financing)}</td></tr><tr><td></td><td>Opening Cash & Bank</td><td>${acctMoney(t.openingCash)}</td></tr><tr class="report-total"><td></td><td>Closing Cash & Bank</td><td>${acctMoney(t.closingCash)}</td></tr>`}const names={'profit-loss':'DNL_Profit_and_Loss','balance-sheet':'DNL_Balance_Sheet','cash-flow':'DNL_Cash_Flow'};$('fsReportOut').innerHTML=`<div class="card financial-statement"><div class="toolbar"><div><h3>${esc(d.meta.title)}</h3><p class="muted">${esc(d.meta.period)}</p></div><div>${acctExportButtons('/accounting-reports/'+type,p,names[type])}</div></div><table class="statement-table"><thead><tr><th>Code / Date</th><th>Description</th><th>Amount</th></tr></thead><tbody>${body}</tbody></table></div>`}

async function renderGLTransactionsPage(){setTitle('GL Transaction Extraction','Search accounting entries across all accounts and source documents');const accounts=await api('/accounting/accounts');$('content').innerHTML=`<div class="card safe-card"><div class="accounting-filter-grid"><select id="gxAccount" class="control"><option value="">All accounts</option>${accounts.map(a=>`<option value="${a.id}">${esc(a.accountCode)} — ${esc(a.name)}</option>`).join('')}</select><input id="gxFrom" type="date" class="control"><input id="gxTo" type="date" class="control"><input id="gxQ" class="control" placeholder="Journal, reference or narration"><button class="primary" onclick="loadGLTransactions()">Extract</button></div></div><div id="gxOut"></div>`}
async function loadGLTransactions(){const p={accountId:$('gxAccount').value,from:$('gxFrom').value,to:$('gxTo').value,q:$('gxQ').value},d=await api(`/accounting-reports/transactions?${acctQS(p)}`);$('gxOut').innerHTML=`<div class="card safe-card"><div class="toolbar"><h3>GL Transactions</h3><div>${acctExportButtons('/accounting-reports/transactions',p,'DNL_GL_Extraction')}</div></div><div class="tablewrap"><table><thead><tr><th>Date</th><th>Journal</th><th>Reference</th><th>Source</th><th>Code</th><th>Account</th><th>Description</th><th>Debit</th><th>Credit</th></tr></thead><tbody>${d.rows.map(x=>`<tr><td>${dateOnly(x.date)}</td><td>${esc(x.journalNo)}</td><td>${esc(x.reference)}</td><td>${esc(x.source)}</td><td>${esc(x.code)}</td><td>${esc(x.account)}</td><td>${esc(x.description)}</td><td>${x.debit?acctMoney(x.debit):''}</td><td>${x.credit?acctMoney(x.credit):''}</td></tr>`).join('')||'<tr><td colspan="9">No transactions found.</td></tr>'}</tbody></table></div></div>`}

async function renderOpeningBalancesPage(){setTitle('Opening Balances','Post opening balances through a controlled balanced journal');const accounts=await api('/accounting/accounts');window.glAccounts=accounts;$('content').innerHTML=`<div class="card safe-card"><p class="muted">Opening balances are posted as a normal balanced journal so the audit trail is preserved. Enter at least two lines and ensure total debit equals total credit.</p><div class="safe-form-grid"><input id="obDate" type="date" class="control" value="${new Date().toISOString().slice(0,10)}"><input id="obRef" class="control" placeholder="Reference, e.g. OPEN-2026"></div><div id="obLines"></div><div class="toolbar"><button class="ghost" onclick="addOpeningBalanceLine()">+ Add Line</button><button class="primary" onclick="postOpeningBalances()">Post Opening Balances</button></div></div>`;addOpeningBalanceLine();addOpeningBalanceLine()}
function addOpeningBalanceLine(){const box=$('obLines');if(!box)return;const opts=(window.glAccounts||[]).filter(a=>a.active&&a.allowPosting).map(a=>`<option value="${a.id}">${esc(a.accountCode)} — ${esc(a.name)}</option>`).join('');box.insertAdjacentHTML('beforeend',`<div class="journal-line opening-line"><select class="control obAccount"><option value="">Account</option>${opts}</select><input class="control obDebit" type="number" step="0.01" placeholder="Debit"><input class="control obCredit" type="number" step="0.01" placeholder="Credit"><input class="control obNarr" placeholder="Narration"><button class="danger" onclick="this.parentElement.remove()">×</button></div>`)}
async function postOpeningBalances(){const lines=[...document.querySelectorAll('.opening-line')].map(r=>({accountId:r.querySelector('.obAccount').value,debit:Number(r.querySelector('.obDebit').value||0),credit:Number(r.querySelector('.obCredit').value||0),narration:r.querySelector('.obNarr').value})).filter(x=>x.accountId&&(x.debit||x.credit));const dr=lines.reduce((s,x)=>s+x.debit,0),cr=lines.reduce((s,x)=>s+x.credit,0);if(Math.abs(dr-cr)>.01)return toast(`Opening balances must balance. Debit ${acctMoney(dr)} vs Credit ${acctMoney(cr)}.`,true);try{await api('/accounting/journals',{method:'POST',body:JSON.stringify({journalDate:$('obDate').value,description:'Opening balances',referenceNo:$('obRef').value||'OPENING',lines})});toast('Opening balances posted successfully.');page('journal-register',true)}catch(e){toast(e.message,true)}}
