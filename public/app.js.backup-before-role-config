async function renderBudgets(){setTitle('Budgets vs Actual','Set GL budgets and compare actual posted results');const [rows,accounts]=await Promise.all([api('/budgets'),api('/accounting/accounts')]);window.budgetAccounts=accounts;window.budgets=rows;$('content').innerHTML=`${can('BUDGET_MANAGE')?`<div class="card safe-card"><h3>Create Budget</h3><div class="safe-form-grid"><input id="bdName" class="control" placeholder="Budget name"><input id="bdStart" type="date" class="control"><input id="bdEnd" type="date" class="control"><select id="bdStatus" class="control"><option>DRAFT</option><option>ACTIVE</option></select></div><div id="budgetLines"></div><div class="toolbar"><button class="ghost" onclick="addBudgetLine()">+ Budget Line</button><button class="primary" onclick="saveBudget()">Save Budget</button></div></div>`:''}<div class="tablewrap"><table><thead><tr><th>Budget</th><th>Name</th><th>Period</th><th>Status</th><th>Lines</th><th>Action</th></tr></thead><tbody>${rows.map(x=>`<tr><td>${esc(x.budgetNo)}</td><td>${esc(x.name)}</td><td>${dateOnly(x.startDate)} – ${dateOnly(x.endDate)}</td><td>${esc(x.status)}</td><td>${x.lines.length}</td><td><button class="ghost" onclick="viewBudgetVariance('${x.id}')">Variance</button>${can('BUDGET_MANAGE')?` <button class="ghost" onclick="setBudgetStatus('${x.id}','${x.status==='ACTIVE'?'CLOSED':'ACTIVE'}')">${x.status==='ACTIVE'?'Close':'Activate'}</button>`:''}</td></tr>`).join('')||'<tr><td colspan="6">No budgets.</td></tr>'}</tbody></table></div>`;if(can('BUDGET_MANAGE'))addBudgetLine()}
function addBudgetLine(){const box=$('budgetLines'),opts=(window.budgetAccounts||[]).filter(x=>x.active).map(x=>`<option value="${x.id}">${esc(x.accountCode)} — ${esc(x.name)}</option>`).join('');box?.insertAdjacentHTML('beforeend',`<div class="budget-line"><select class="control bdAccount"><option value="">GL Account</option>${opts}</select><input class="control bdAmount" type="number" step="0.01" placeholder="Budget amount"><input class="control bdNotes" placeholder="Notes"><button class="danger" onclick="this.parentElement.remove()">×</button></div>`)}
async function saveBudget(){try{const lines=[...document.querySelectorAll('.budget-line')].map(r=>({accountId:r.querySelector('.bdAccount').value,amount:Number(r.querySelector('.bdAmount').value||0),notes:r.querySelector('.bdNotes').value})).filter(x=>x.accountId);await api('/budgets',{method:'POST',body:JSON.stringify({name:$('bdName').value,startDate:$('bdStart').value,endDate:$('bdEnd').value,status:$('bdStatus').value,lines})});toast('Budget created.');renderBudgets()}catch(e){toast(e.message,true)}}
async function viewBudgetVariance(id){try{const d=await api(`/budgets/${id}/variance`);$('content').innerHTML=`<div class="toolbar"><div><h3>${esc(d.budget.name)} — Variance</h3><p class="muted">${dateOnly(d.budget.startDate)} – ${dateOnly(d.budget.endDate)}</p></div><button class="ghost" onclick="renderBudgets()">← Budgets</button></div><div class="grid"><div class="card metric"><span>Total Budget</span><b>${money(d.totalBudget)}</b></div><div class="card metric"><span>Total Actual</span><b>${money(d.totalActual)}</b></div><div class="card metric"><span>Net Variance</span><b>${money(d.totalActual-d.totalBudget)}</b></div></div><div class="tablewrap"><table><thead><tr><th>Account</th><th>Budget</th><th>Actual</th><th>Variance</th><th>Variance %</th></tr></thead><tbody>${d.rows.map(x=>`<tr><td>${esc(x.account.accountCode)} — ${esc(x.account.name)}</td><td>${money(x.budget)}</td><td>${money(x.actual)}</td><td>${money(x.variance)}</td><td>${x.variancePct===null?'—':x.variancePct+'%'}</td></tr>`).join('')}</tbody></table></div>`}catch(e){toast(e.message,true)}}
async function setBudgetStatus(id,status){try{await api(`/budgets/${id}/status`,{method:'PUT',body:JSON.stringify({status})});toast(`Budget ${status.toLowerCase()}.`);renderBudgets()}catch(e){toast(e.message,true)}}

async function renderBatches(){setTitle('Batch / Lot & Expiry Register','Optional lot allocation and near-expiry control by stock location');const [rows,alerts,items,locs]=await Promise.all([api('/batches'),api('/batches/alerts'),api('/inventory/items'),api('/locations')]);$('content').innerHTML=`<div class="grid"><div class="card metric"><span>Tracked Batches</span><b>${rows.length}</b></div><div class="card metric"><span>Expiry Alerts</span><b>${alerts.length}</b></div><div class="card metric"><span>Active Batch Qty</span><b>${rows.filter(x=>x.status==='ACTIVE').reduce((s,x)=>s+Number(x.quantity||0),0).toLocaleString()}</b></div></div>${can('BATCH_MANAGE')?`<div class="card safe-card"><h3>Add Batch / Lot Allocation</h3><p class="muted">This allocates existing stock to a traceable batch; it does not create new physical stock.</p><div class="safe-form-grid"><select id="btItem" class="control"><option value="">Item</option>${items.rows.filter(x=>x.active).map(x=>`<option value="${x.id}">${esc(x.itemCode)} — ${esc(x.name)}</option>`).join('')}</select><select id="btLoc" class="control"><option value="">Location</option>${locs.filter(x=>x.active).map(x=>`<option value="${x.id}">${esc(x.name)}</option>`).join('')}</select><input id="btNo" class="control" placeholder="Batch / lot number"><input id="btQty" type="number" class="control" placeholder="Quantity"><input id="btMfg" type="date" class="control"><input id="btExp" type="date" class="control"><input id="btCost" type="number" step="0.0001" class="control" placeholder="Unit cost (optional)"><button class="primary" onclick="createBatch()">Save Batch</button></div></div>`:''}<div class="tablewrap"><table><thead><tr><th>Code</th><th>Item</th><th>Location</th><th>Batch</th><th>Mfg.</th><th>Expiry</th><th>Qty</th><th>Unit Cost</th><th>Status</th><th>Action</th></tr></thead><tbody>${rows.map(x=>`<tr><td>${esc(x.batchCode)}</td><td>${esc(x.item.name)}</td><td>${esc(x.location.name)}</td><td>${esc(x.batchNo)}</td><td>${dateOnly(x.manufactureDate)}</td><td>${dateOnly(x.expiryDate)}</td><td>${Number(x.quantity).toLocaleString()}</td><td>${money(x.unitCost)}</td><td>${esc(x.status)}</td><td>${can('BATCH_MANAGE')?`<button class="ghost" onclick="editBatchStatus('${x.id}','${x.status}')">Status</button>`:''}</td></tr>`).join('')||'<tr><td colspan="10">No batches tracked.</td></tr>'}</tbody></table></div>`}
async function createBatch(){try{await api('/batches',{method:'POST',body:JSON.stringify({itemId:$('btItem').value,locationId:$('btLoc').value,batchNo:$('btNo').value,quantity:$('btQty').value,manufactureDate:$('btMfg').value,expiryDate:$('btExp').value,unitCost:$('btCost').value})});toast('Batch created.');renderBatches()}catch(e){toast(e.message,true)}}
async function editBatchStatus(id,current){const status=await uiInput('Batch status',current,{title:'Batch Status',options:['ACTIVE','QUARANTINED','EXPIRED','DEPLETED'].map(x=>({value:x,label:x}))});if(!status)return;try{await api(`/batches/${id}`,{method:'PATCH',body:JSON.stringify({status})});toast('Batch updated.');renderBatches()}catch(e){toast(e.message,true)}}

async function renderAuditExceptions(){setTitle('Audit Exception Dashboard','System-generated risk flags requiring management or auditor review');const rows=await api('/controls/exceptions');$('content').innerHTML=`<div class="toolbar"><div><b>Exception Register</b><div class="muted">High-value, high-discount, backdated, manual-bank and material stock-adjustment risks.</div></div>${can('AUDIT_EXCEPTION_SCAN')?'<button class="primary" onclick="scanAuditExceptions()">Run Exception Scan</button>':''}</div><div class="tablewrap"><table><thead><tr><th>Date</th><th>Severity</th><th>Category</th><th>Exception</th><th>Entity</th><th>Status</th><th>Action</th></tr></thead><tbody>${rows.map(x=>`<tr><td>${dateOnly(x.exceptionDate)}</td><td><b>${esc(x.severity)}</b></td><td>${esc(x.category)}</td><td><b>${esc(x.title)}</b><br><small>${esc(x.description)}</small></td><td>${esc(x.entity||'')} ${esc(x.entityId||'')}</td><td>${esc(x.status)}</td><td>${can('AUDIT_EXCEPTION_MANAGE')&&x.status==='OPEN'?`<button class="ghost" onclick="ackAuditException('${x.id}')">Acknowledge</button>`:''}${can('AUDIT_EXCEPTION_MANAGE')&&x.status!=='RESOLVED'?` <button class="primary" onclick="resolveAuditException('${x.id}')">Resolve</button>`:''}</td></tr>`).join('')||'<tr><td colspan="7">No audit exceptions.</td></tr>'}</tbody></table></div>`}
async function scanAuditExceptions(){try{loading(true,'Scanning exceptions…','Reviewing recent transactions');const r=await api('/controls/exceptions/scan',{method:'POST',body:'{}'});toast(`${r.created} new exception(s) flagged.`);renderAuditExceptions()}catch(e){toast(e.message,true)}finally{loading(false)}}
async function ackAuditException(id){try{await api(`/controls/exceptions/${id}/acknowledge`,{method:'POST',body:'{}'});toast('Exception acknowledged.');renderAuditExceptions()}catch(e){toast(e.message,true)}}
async function resolveAuditException(id){const resolution=await uiInput('Resolution / action taken','',{title:'Resolve Audit Exception',multiline:true});if(!resolution)return;try{await api(`/controls/exceptions/${id}/resolve`,{method:'POST',body:JSON.stringify({resolution})});toast('Exception resolved.');renderAuditExceptions()}catch(e){toast(e.message,true)}}

async function renderSessions(){setTitle('Security & Sessions','Review active sign-ins and revoke access where necessary');const mine=await api('/sessions/mine'),all=can('SESSION_MANAGE')?await api('/sessions/admin'):null;const rows=all||mine;$('content').innerHTML=`<div class="card safe-card"><div class="toolbar"><div><h3>${all?'All User Sessions':'My Sessions'}</h3><p class="muted">Revoking a session immediately invalidates its current token on the next request.</p></div></div><div class="tablewrap"><table><thead><tr>${all?'<th>User</th>':''}<th>Created</th><th>Last Seen</th><th>Expires</th><th>Device / Browser</th><th>IP Hint</th><th>Status</th><th>Action</th></tr></thead><tbody>${rows.map(x=>`<tr>${all?`<td>${esc(x.user?.firstName||'')} ${esc(x.user?.lastName||'')}<br><small>${esc(x.user?.email||'')}</small></td>`:''}<td>${new Date(x.createdAt).toLocaleString()}</td><td>${new Date(x.lastSeenAt).toLocaleString()}</td><td>${new Date(x.expiresAt).toLocaleString()}</td><td>${esc(x.userAgent||'Unknown')}</td><td>${esc(x.ipHint||'')}</td><td>${x.current?'CURRENT ':''}${x.revokedAt?'REVOKED':'ACTIVE'}</td><td>${!x.revokedAt&&!x.current?`<button class="danger" onclick="revokeSession('${x.id}',${all?'true':'false'})">Revoke</button>`:''}</td></tr>`).join('')}</tbody></table></div></div>`}
