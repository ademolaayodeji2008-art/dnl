tr></thead><tbody>${d.cheques.map(c=>`<tr><td>${esc(c.chequeNo)}</td><td>${esc(c.drawerBank)}</td><td>${money(c.amount)}</td><td>${esc(c.status)}</td><td>${dateOnly(c.expectedPresentationDate)}</td></tr>`).join('')||'<tr><td colspan="5" class="muted">No cheque history.</td></tr>'}</tbody></table></div></div>`}catch(e){toast(e.message,true)}}
